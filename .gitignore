# no vendor binaries, ever
*.dll
*.exe
*.bak
*.p7
*.p8

# build artefacts
*.obj
*.exp
*.lib
*.pdb

# except our own patcher - it is built from source in this repo and is the
# whole point of the Madium folder, so people do not need a C++ toolchain
!Madium/tools/madium_unlock.exe

# analysis artefacts (regenerate with ServBay/tools)
methods.tsv
tp_methods.tsv
types.txt
*_state/
_teststate/
work/
sim/

# Madium: the local Ed25519 keypair never leaves the machine
Madium/state/
*.pub

# logs / captures
*.log
*.png
sb_out.txt
sb_err.txt

# python bytecode
__pycache__/
*.pyc
